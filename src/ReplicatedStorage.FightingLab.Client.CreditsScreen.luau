--!strict
-- Renders the in-game CREDITS page from ReplicatedStorage.FightingLab.Credits (generated by tools/gen_credits.py from
-- the fighter specs). The lobby menu (LobbyUI) owns navigation; this module only builds the page and scrolls it.
-- theme.compact drops the big title (the lobby menu already shows a header) and lets the list fill the page.
-- Sections: one per fighter (rows named "Row"), then "LOBBY & ARENAS" for the world's Creator Store assets (rows named
-- "WorldRow", only when data.world is non-empty), then "MOTION CAPTURE & ADDITIONAL CREDITS" for data.external
-- (rows named "External"; each wraps to as many lines as its attribution needs).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

export type Theme = {
	font: Enum.Font?, bodyFont: Enum.Font?, fontFace: Font?, bodyFace: Font?,
	gold: Color3?, text: Color3?, muted: Color3?, compact: boolean?, hint: string?,
}
type Item = { name: string, creator: string, kind: string, id: number }
type WorldItem = { name: string, creator: string, kind: string?, usedFor: string?, id: number? }
export type CreditsData = {
	intro: string,
	fighters: { { name: string, items: { Item } } },
	external: { { credit: string, license: string, usedFor: string } }?,
	world: { WorldItem }?,
}

local CreditsScreen = {}
CreditsScreen.EXTERNAL_HEADER = "MOTION CAPTURE & ADDITIONAL CREDITS"

local SCROLL_STEP = 140

local function loadData(): CreditsData?
	local folder = ReplicatedStorage:FindFirstChild("FightingLab")
	local module = folder and folder:FindFirstChild("Credits")
	if not module or not module:IsA("ModuleScript") then return nil end
	local ok, data = pcall(require, module)
	if not ok or type(data) ~= "table" then return nil end
	return data :: any
end

local function applyFont(label: TextLabel, face: Font?, font: Enum.Font)
	if face then label.FontFace = face else label.Font = font end
end

local function text(parent: Instance, name: string, value: string, size: number, face: Font?, font: Enum.Font, color: Color3, height: number, order: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -12, 0, height)
	applyFont(label, face, font)
	label.TextSize = size
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.Text = value
	label.LayoutOrder = order
	label.Parent = parent
	return label
end

-- override replaces the generated ReplicatedStorage.FightingLab.Credits data (tests).
function CreditsScreen.render(parent: Instance, theme: Theme?, override: CreditsData?): Frame
	local t = theme or {}
	local font = t.font or Enum.Font.GothamBold
	local bodyFont = t.bodyFont or Enum.Font.GothamMedium
	local gold = t.gold or Color3.fromRGB(255, 205, 96)
	local white = t.text or Color3.fromRGB(240, 240, 245)
	local muted = t.muted or Color3.fromRGB(170, 176, 190)
	local compact = t.compact == true

	local root = Instance.new("Frame")
	root.Name = "Credits"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)

	if not compact then
		local title = Instance.new("TextLabel")
		title.Name = "Title"
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, 0, 0, 54)
		title.Position = UDim2.fromScale(0, 0.08)
		applyFont(title, t.fontFace, font)
		title.TextSize = 40
		title.TextColor3 = gold
		title.Text = "CREDITS"
		title.Parent = root
	end

	local data = override or loadData()
	local intro = Instance.new("TextLabel")
	intro.Name = "Intro"
	intro.BackgroundTransparency = 1
	intro.Size = if compact then UDim2.new(1, 0, 0, 44) else UDim2.new(0.78, 0, 0, 44)
	intro.Position = if compact then UDim2.new() else UDim2.new(0.11, 0, 0.08, 60)
	applyFont(intro, t.bodyFace, bodyFont)
	intro.TextSize = 16
	intro.TextWrapped = true
	intro.TextXAlignment = if compact then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center
	intro.TextColor3 = muted
	intro.Text = if data then data.intro else "Credits data is unavailable in this build."
	intro.Parent = root

	local list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.BackgroundColor3 = Color3.fromRGB(14, 16, 24)
	list.BackgroundTransparency = 0.25
	list.BorderSizePixel = 0
	list.Size = if compact then UDim2.new(1, 0, 1, -84) else UDim2.new(0.78, 0, 0.62, 0)
	list.Position = if compact then UDim2.fromOffset(0, 52) else UDim2.new(0.11, 0, 0.08, 116)
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.ScrollBarThickness = 6
	list.ScrollBarImageColor3 = gold
	list.Parent = root
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 6); corner.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 14); pad.PaddingBottom = UDim.new(0, 14); pad.PaddingLeft = UDim.new(0, 18); pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = list
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 4)
	layout.Parent = list

	local order = 0
	local function nextOrder(): number order += 1; return order end
	if data then
		for _, fighter in ipairs(data.fighters or {}) do
			local header = text(list, "Fighter_" .. fighter.name, fighter.name, 22, t.fontFace, font, white, 30, nextOrder())
			header.TextColor3 = gold
			for _, item in ipairs(fighter.items) do
				local kind = if item.kind ~= "" then "  (" .. item.kind .. ")" else ""
				local row = text(list, "Row", item.name .. "  -  by " .. item.creator .. kind, 16, t.bodyFace, bodyFont, muted, 22, nextOrder())
				row.TextTruncate = Enum.TextTruncate.AtEnd
				row.TextWrapped = false
			end
			text(list, "Gap", "", 8, t.bodyFace, bodyFont, muted, 10, nextOrder())
		end
		local world = data.world
		if world and #world > 0 then
			local header = text(list, "WorldHeader", "LOBBY & ARENAS", 22, t.fontFace, font, white, 30, nextOrder())
			header.TextColor3 = gold
			for _, item in ipairs(world) do
				local kind = if typeof(item.kind) == "string" and item.kind ~= "" then "  (" .. item.kind .. ")" else ""
				local row = text(list, "WorldRow", tostring(item.name) .. "  -  by " .. tostring(item.creator) .. kind, 16, t.bodyFace, bodyFont, muted, 22, nextOrder())
				row.TextTruncate = Enum.TextTruncate.AtEnd
				row.TextWrapped = false
			end
			text(list, "Gap", "", 8, t.bodyFace, bodyFont, muted, 10, nextOrder())
		end
		local external = data.external
		if external and #external > 0 then
			-- Motion capture and other non-Roblox sources (ACCAD, CMU, Quaternius...): long attributions wrap onto as
			-- many lines as they need instead of being cut off.
			local header = text(list, "ExternalHeader", CreditsScreen.EXTERNAL_HEADER, 22, t.fontFace, font, white, 30, nextOrder())
			header.TextColor3 = gold
			local function esc(s: string): string
				return (string.gsub(string.gsub(string.gsub(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
			end
			local metaColor = string.format("#%02X%02X%02X", math.floor(muted.R * 255 * 0.82), math.floor(muted.G * 255 * 0.82), math.floor(muted.B * 255 * 0.82))
			for _, entry in ipairs(external) do
				local credit = tostring(entry.credit or "")
				local license = tostring(entry.license or "")
				local usedFor = tostring(entry.usedFor or "")
				-- Line 1: the attribution exactly as the source asks for it; line 2 (smaller): licence and what it is used for.
				local meta = {}
				if license ~= "" and not string.find(credit, license, 1, true) then table.insert(meta, "License: " .. esc(license)) end
				if usedFor ~= "" then table.insert(meta, "Used for: " .. esc(usedFor)) end
				local body = esc(credit)
				if #meta > 0 then body ..= "\n<font size=\"14\" color=\"" .. metaColor .. "\">" .. table.concat(meta, "  ·  ") .. "</font>" end
				local row = text(list, "External", body, 16, t.bodyFace, bodyFont, white, 0, nextOrder())
				row.RichText = true
				row.TextWrapped = true
				row.TextTruncate = Enum.TextTruncate.None
				row.TextYAlignment = Enum.TextYAlignment.Top
				row.AutomaticSize = Enum.AutomaticSize.Y
				row.Size = UDim2.new(1, -12, 0, 20)
				local pad = Instance.new("UIPadding")
				pad.PaddingBottom = UDim.new(0, 10)
				pad.Parent = row
			end
		end
	end

	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.Size = UDim2.new(1, 0, 0, 24)
	hint.Position = if compact then UDim2.new(0, 0, 1, -24) else UDim2.new(0, 0, 0.92, 0)
	applyFont(hint, t.bodyFace, bodyFont)
	hint.TextSize = 15
	hint.TextColor3 = muted
	hint.Text = t.hint or "W/S or Up/Down scroll  |  Backspace / B back"
	hint.Parent = root

	root.Parent = parent
	return root
end

-- direction: -1 scrolls up, 1 scrolls down. Returns the new canvas offset. `root` is the page returned by render (or
-- any ancestor of it).
function CreditsScreen.scroll(root: Instance, direction: number): number
	local list = root:FindFirstChild("List")
	if not list then
		local page = root:FindFirstChild("Credits", true)
		list = page and page:FindFirstChild("List")
	end
	if not list or not list:IsA("ScrollingFrame") then return 0 end
	local maxY = math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteWindowSize.Y)
	local y = math.clamp(list.CanvasPosition.Y + SCROLL_STEP * math.sign(direction), 0, maxY)
	list.CanvasPosition = Vector2.new(0, y)
	return y
end

function CreditsScreen.hasData(): boolean
	return loadData() ~= nil
end

return CreditsScreen
