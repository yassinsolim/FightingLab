--!strict
local Lab = game:GetService("ReplicatedStorage").FightingLab
local RB = require(Lab.RenderBuffer)
local Config = require(Lab.CombatConfig)
local Runner = require(game:GetService("ServerStorage").UnitTest.RunUnitTest)
type TestContext = Runner.T
local function fighter(x: number, state: string?): { [string]: any }
	return {
		pos = Vector3.new(x, 0, 0), facing = Vector3.xAxis, health = 100, state = state or "Walk", moveFrame = 0,
		stun = 0, combo = 0, crouched = false, walkPhase = x, moveX = 1, throw = { role = "Attacker", archetype = "Hip", frame = 2, duration = 40, impactFrame = 18 },
		armorActive = true, crush = "High", velocityY = 4, airFrames = 5, airHits = 2, knockdown = "FaceUp", dashDirection = -1,
		lastHit = { kind = "Hit", height = "Mid", tier = "Light", counter = true, frame = 12, move = "Jab", limb = "RightHand", side = 1 },
	}
end
local function snap(frame: number, x: number, opts: { [string]: any }?): RB.Entry
	local o = opts or {}
	local raw = { frame = frame, epoch = o.epoch or 1, phase = o.phase or "Fight", mode = "Match", ko = o.ko == true, fighters = { fighter(x, o.state), fighter(-x) }, events = {} }
	local e = RB.parse(raw)
	assert(e, "fixture must parse")
	return e
end
return function(t: TestContext)
	local function event(frame: number, kind: string?): RB.SnapEvent
		return { frame = frame, kind = kind or "Hit", attacker = 1, target = 2, move = "Jab", damage = 7, advantage = 3, combo = 1, air = false }
	end
	t.test("repeated event payloads enqueue and drain exactly once", function()
		local q = RB.newEventQueue()
		t.expect.truthy(RB.enqueueEvent(q, event(31)))
		t.expect.falsy(RB.enqueueEvent(q, event(31)))
		t.expect.equal(#RB.drainEvents(q, 30.9 / Config.FPS), 0)
		t.expect.equal(#RB.drainEvents(q, 31 / Config.FPS), 1)
		t.expect.falsy(RB.enqueueEvent(q, event(31)))
		t.expect.equal(#RB.drainEvents(q, 32 / Config.FPS), 0)
	end)
	t.test("whiff logs use the same due timeline and duplicate protection", function()
		local q = RB.newEventQueue()
		RB.enqueueEvent(q, event(31, "Whiff"))
		t.expect.falsy(RB.enqueueEvent(q, event(31, "Whiff")))
		t.expect.equal(#RB.drainEvents(q, 30 / Config.FPS), 0)
		t.expect.equal(RB.drainEvents(q, 31 / Config.FPS)[1].kind, "Whiff")
	end)
	t.test("epoch cleanup discards pending events and permits new frame IDs", function()
		local q = RB.newEventQueue()
		RB.enqueueEvent(q, event(31))
		RB.clearEvents(q)
		t.expect.equal(#RB.drainEvents(q, 50 / Config.FPS), 0)
		t.expect.truthy(RB.enqueueEvent(q, event(31)))
		t.expect.equal(#RB.drainEvents(q, 31 / Config.FPS), 1)
	end)
	t.test("replayed same-frame snapshots do not flush event deduplication", function()
		local b, q = RB.new(), RB.newEventQueue()
		local e = snap(31, 0)
		table.insert(e.events, event(31))
		if RB.push(b, e, 10) then RB.clearEvents(q) end
		RB.enqueueEvent(q, e.events[1])
		t.expect.equal(#RB.drainEvents(q, 31 / Config.FPS), 1)
		if RB.push(b, e, 10.01) then RB.clearEvents(q) end
		t.expect.falsy(RB.enqueueEvent(q, e.events[1]))
		t.expect.equal(#b.entries, 1)
		t.expect.equal(#RB.drainEvents(q, 31 / Config.FPS), 0)
	end)
	t.test("event timing uses contact frame rather than containing snapshot frame", function()
		local raw = { frame = 33, phase = "Fight", mode = "Training", fighters = { fighter(0), fighter(3) }, events = { { kind = "Hit", attacker = 1, target = 2, move = "Jab", frame = 31, height = "Mid", limb = "RightHand" } } }
		local e = RB.parse(raw)
		assert(e)
		t.expect.near(RB.eventTime(e.events[1]), 31 / Config.FPS, 1e-6)
		t.expect.equal(RB.eventKey(e.events[1]), "1:31:Jab:Hit")
		t.expect.equal(e.events[1].height, "Mid")
		t.expect.equal(e.events[1].limb, "RightHand")
	end)
	t.test("render clock is monotonic under uneven arrivals and resets with epoch", function()
		local b = RB.new()
		RB.push(b, snap(30, 0), 10)
		local old = RB.renderTime(b, 10.1)
		RB.push(b, snap(31, 0), 10.5)
		t.expect.truthy(RB.renderTime(b, 10.1) >= old)
		RB.push(b, snap(0, 0, { epoch = 2 }), 11)
		t.expect.truthy(RB.renderTime(b, 11) < old)
	end)
	t.test("does not present a new startup or defender stun before its actual frame", function()
		local b = RB.new()
		local a, nextEntry = snap(30, 0), snap(32, 0)
		nextEntry.fighters[1].move = "Jab"
		nextEntry.fighters[1].moveFrame = 1
		nextEntry.fighters[1].state = "Startup"
		nextEntry.fighters[2].state = "Hitstun"
		RB.push(b, a, 10)
		RB.push(b, nextEntry, 10.04)
		local before = RB.sampleAt(b, 1, 31.9 / Config.FPS)
		local defender = RB.sampleAt(b, 2, 31.9 / Config.FPS)
		assert(before and defender)
		t.expect.equal(before.move, nil)
		t.expect.equal(defender.state, "Walk")
		local at = RB.sampleAt(b, 1, 32 / Config.FPS)
		assert(at)
		t.expect.equal(at.move, "Jab")
		t.expect.equal(at.moveFrame, 1)
	end)
	local period = Config.SnapshotEvery / Config.FPS
	t.test("rejects malformed remote payloads", function()
		t.expect.falsy(RB.parse(nil))
		t.expect.falsy(RB.parse({ frame = "x" }))
		t.expect.falsy(RB.parse({ frame = 1, phase = "Fight", mode = "Match", fighters = { { pos = 1 } } }))
	end)
	t.test("interpolates between bracketing authoritative snapshots", function()
		local b = RB.new()
		RB.push(b, snap(30, 0), 10)
		RB.push(b, snap(33, 3), 10.05)
		local r = RB.sampleAt(b, 1, (31.5) / Config.FPS)
		assert(r)
		t.expect.near(r.pos.X, 1.5, 1e-4)
		t.expect.equal(r.extrapolated, 0)
		t.expect.truthy(r.throw ~= nil)
		t.expect.equal(r.armorActive, true)
		t.expect.equal(r.crush, "High")
		t.expect.equal(r.velocityY, 4)
		t.expect.equal(r.airFrames, 5)
		t.expect.equal(r.airHits, 2)
		t.expect.equal(r.knockdown, "FaceUp")
		t.expect.equal(r.dashDirection, -1)
		t.expect.equal((r.lastHit :: any).limb, "RightHand")
	end)
	t.test("extrapolates unlocked fighters at most one snapshot period", function()
		local b = RB.new()
		RB.push(b, snap(30, 0), 10)
		RB.push(b, snap(33, 3), 10.05)
		local r = RB.sampleAt(b, 1, 33 / Config.FPS + 10)
		assert(r)
		t.expect.near(r.extrapolated, period, 1e-6)
		t.expect.near(r.pos.X, 3 + 3 / period * period, 1e-3)
	end)
	t.test("never extrapolates locked, KO or non-fight states", function()
		for _, opts in { { state = "Active" }, { ko = true }, { phase = "Ready" }, { phase = "RoundOver" }, { state = "Hitstun" } } do
			local b = RB.new()
			RB.push(b, snap(30, 0, opts), 10)
			RB.push(b, snap(33, 3, opts), 10.05)
			local r = RB.sampleAt(b, 1, 34 / Config.FPS)
			assert(r)
			t.expect.equal(r.extrapolated, 0)
			t.expect.near(r.pos.X, 3, 1e-6)
		end
	end)
	t.test("flushes on epoch change, frame rewind and entering Ready", function()
		local b = RB.new()
		t.expect.truthy(RB.push(b, snap(30, 0), 10))
		t.expect.falsy(RB.push(b, snap(33, 1), 10.05))
		t.expect.truthy(RB.push(b, snap(36, 0, { epoch = 2 }), 10.1))
		t.expect.equal(#b.entries, 1)
		RB.push(b, snap(39, 1, { epoch = 2 }), 10.15)
		t.expect.truthy(RB.push(b, snap(12, 1, { epoch = 2 }), 10.2))
		RB.push(b, snap(15, 1, { epoch = 2 }), 10.25)
		t.expect.truthy(RB.push(b, snap(18, 1, { epoch = 2, phase = "Ready" }), 10.3))
		t.expect.equal(#b.entries, 1)
	end)
	t.test("teleports snap instead of sliding across the stage", function()
		local b = RB.new()
		RB.push(b, snap(30, 0), 10)
		RB.push(b, snap(33, 12), 10.05)
		local r = RB.sampleAt(b, 1, 31 / Config.FPS)
		assert(r)
		t.expect.truthy(r.pos.X == 0 or r.pos.X == 12)
	end)
	t.test("render delay stays near one snapshot period behind the newest arrival", function()
		local b = RB.new()
		for k = 0, 9 do RB.push(b, snap(30 + k * 3, k), 100 + k * period) end
		local latest = RB.latest(b)
		assert(latest)
		local behind = latest.time - RB.renderTime(b, 100 + 9 * period)
		t.expect.truthy(behind >= period and behind <= period + 0.02, "delay " .. behind)
		t.expect.truthy(behind < 0.1, "must be below the previous fixed 100 ms")
	end)
	t.test("adaptive 60 Hz buffers grow the delay when rendering starves and shrink it while fed", function()
		local step = 1 / Config.FPS
		local b = RB.new({ period = step, adaptive = true })
		local start = b.delay
		for k = 0, 300 do
			RB.push(b, snap(k, 0), 100 + k * step)
			RB.renderTime(b, 100 + k * step)
		end
		t.expect.equal(b.starved, 0)
		t.expect.truthy(b.delay < start, "fed frames shrink the delay: " .. b.delay)
		t.expect.truthy(b.delay >= b.minDelay)
		local before = b.delay
		for k = 1, 30 do RB.renderTime(b, 100 + (300 + k) * step) end
		t.expect.truthy(b.starved > 0, "rendering past the newest entry counts as starvation")
		t.expect.truthy(b.delay > before, "starvation grows the delay")
		t.expect.truthy(b.delay <= before + 6 * b.grow, "growth is rate limited: " .. (b.delay - before))
		t.expect.truthy(b.delay <= b.maxDelay)
	end)
	t.test("entries keep their matchId", function()
		local raw = { frame = 5, phase = "Fight", mode = "Match", matchId = "Arena_X#3", fighters = { fighter(0), fighter(3) }, events = {} }
		local e = RB.parse(raw)
		assert(e)
		t.expect.equal(e.matchId, "Arena_X#3")
	end)
	t.test("parses guard, sidestep, dash, getup fields, the dummy and evaded whiffs and sanitises bad values", function()
		local a, b = fighter(0, "Sidestep"), fighter(3, "Getup")
		a.stepDir = 1; a.stepFrame = 9; a.guard = "Stand"; a.dashFrame = 3; a.dashTotal = 14; a.stringIndex = 2; a.crouchFrames = 4
		b.getupKind = "BackRoll"; b.rollDir = -1; b.guard = "Sideways"
		local raw = { frame = 9, phase = "Fight", mode = "Training", dummy = "Guard", fighters = { a, b },
			events = { { frame = 9, kind = "Whiff", attacker = 2, target = 1, move = "Jab", damage = 0, advantage = 0, combo = 0, air = false, evaded = true } } }
		local e = RB.parse(raw)
		assert(e)
		t.expect.equal(e.dummy, "Guard")
		t.expect.equal(e.fighters[1].stepDir, 1)
		t.expect.equal(e.fighters[1].stepFrame, 9)
		t.expect.equal(e.fighters[1].guard, "Stand")
		t.expect.equal(e.fighters[1].dashTotal, 14)
		t.expect.equal(e.fighters[1].stringIndex, 2)
		t.expect.equal(e.fighters[1].crouchFrames, 4)
		t.expect.equal(e.fighters[2].getupKind, "BackRoll")
		t.expect.equal(e.fighters[2].rollDir, -1)
		t.expect.equal(e.fighters[2].guard, nil, "unknown guard values are dropped")
		t.expect.equal(e.events[1].evaded, true)
		t.expect.falsy(RB.canExtrapolate(e, e.fighters[1]), "a sidestep is a committed movement")
		local plain = RB.parse({ frame = 10, phase = "Fight", mode = "Match", dummy = "Dance", fighters = { fighter(0), fighter(3) }, events = {} })
		assert(plain)
		t.expect.equal(plain.dummy, nil, "unknown dummy behaviour is dropped")
		t.expect.equal(plain.fighters[1].stepDir, 0, "missing fields default to zero")
	end)
end
