--!strict
-- Registry and decoder for motion-capture clips. Clip modules are DATA, discovered recursively under
-- Motion.Clips.Core (motioncore: stances, locomotion, guards, reactions, falls, getups, KO, victory) and
-- Motion.Clips.Moves (attack agents, any subfolder: Moves.Strikes, Moves.Kicks, Moves.Throws). A module returns one
-- clip table or an array of clip tables; nothing is registered by hand. Generated by OV6/tools/mocap/convert.py.
--
-- FLClip1 (one body track). Fields: format = "FLClip1", name, fps, frames, loop, speed, travel, layout, data,
--   sources = { catalog ids } (credits; line 1 of the module is "-- sources: ..."), and for attacks:
--   fighter = "Kael" | "*" (case-insensitive roster id; "*"/"any"/nil = every fighter), move = "<Roster move key>",
--   stringIndex = n (optional: preferred when the move is hit n of a string), contact = 0..1 (normalised clip time of
--   the impact; or contactFrame = 0-based clip frame), recover = 0..1 (optional: limb back in guard), mirror = true
--   (optional: play mirrored).
-- FLThrow1 (two synchronised roles): format = "FLThrow1", fighter, move, attacker = FLClip1, defender = FLClip1 (in the
--   DEFENDER's own heading space), impact = 0..1 (lands on throw.impactFrame), distance = authored root distance in
--   attacker leg lengths, optional breakAttacker/breakDefender = FLClip1 (played when the throw is broken), sources,
--   optional grips = { { role = "Attacker"|"Defender", limb = "LeftHand"|"RightHand"|"LeftFoot"|"RightFoot",
--   anchor = <GRIP_ANCHORS name> or part = <partner R15 part> + at = { x, y, z } (point in that part's box, -1..1 of
--   the half size per axis, -z = front), from = s, to = s (clip seconds the limb holds on), fade = s, weight = 0..1 } }:
--   after both bodies are posed the limb is re-solved onto the partner's real body point (any fighter sizes).
--
-- Channel layout of FLClip1 (per frame, Roblox character space of the clip heading: +X right, +Y up, -Z toward the
-- opponent):
--   1-3   root position (pelvis), leg-length units; Y is relative to the straight-legged standing height
--   4-7   root (pelvis) rotation quaternion x,y,z,w        8-11  waist (pelvis->chest)     12-15 neck (chest->head)
--   then per limb in LIMBS order (LeftHand, RightHand, LeftFoot, RightFoot), 10 channels each:
--     pos(3)  hands: shoulder->hand in arm-length units; feet: hip->sole point in leg-length units
--     pole(3) unit vector toward which the elbow/knee bends
--     rot(4)  hand/foot rotation quaternion relative to the heading frame
--   56-58 left foot contact, right foot contact, ground (body supported by the floor), all 0..1
local ClipLibrary = {}

export type Clip = {
	name: string,
	fps: number,
	frames: number,
	duration: number,
	loop: boolean,
	channels: { any },
	contact: number?,
	recover: number?,
	speed: number,
	travel: Vector3,
	tags: { [string]: any },
	source: string,
	sources: { string },
	fighter: string?,
	move: string?,
	stringIndex: number?,
	mirror: boolean,
}
export type Grip = { role: string, limb: string, part: string, at: Vector3, from: number, to: number, fade: number, weight: number }
export type ThrowClip = {
	name: string,
	fighter: string?,
	move: string,
	attacker: Clip,
	defender: Clip,
	impact: number,
	distance: number,
	breakAttacker: Clip?,
	breakDefender: Clip?,
	grips: { Grip }?,
	sources: { string },
}

ClipLibrary.FORMAT = "FLClip1"
ClipLibrary.THROW_FORMAT = "FLThrow1"
-- Named grip points on the PARTNER's body (its own left/right): R15 part + point in the part's box (per axis -1..1 of
-- the half size; x right, y up, z back, so -z is the front). Torso fronts sit just outside the surface.
ClipLibrary.GRIP_ANCHORS = {
	Collar = { "UpperTorso", Vector3.new(0, 0.75, -1.2) }, Chest = { "UpperTorso", Vector3.new(0, 0.1, -1.2) },
	Back = { "UpperTorso", Vector3.new(0, 0.1, 1.2) }, Nape = { "Head", Vector3.new(0, -0.75, 1) },
	Belly = { "LowerTorso", Vector3.new(0, 0.5, -1.2) }, LowBack = { "LowerTorso", Vector3.new(0, 0.5, 1.2) },
	LeftHip = { "LowerTorso", Vector3.new(-1.1, 0, 0) }, RightHip = { "LowerTorso", Vector3.new(1.1, 0, 0) },
	LeftShoulder = { "LeftUpperArm", Vector3.new(0, 0.8, 0) }, RightShoulder = { "RightUpperArm", Vector3.new(0, 0.8, 0) },
	LeftElbow = { "LeftLowerArm", Vector3.new(0, 0.9, 0) }, RightElbow = { "RightLowerArm", Vector3.new(0, 0.9, 0) },
	LeftWrist = { "LeftLowerArm", Vector3.new(0, -0.9, 0) }, RightWrist = { "RightLowerArm", Vector3.new(0, -0.9, 0) },
	LeftThigh = { "LeftUpperLeg", Vector3.new(0, 0, -1.1) }, RightThigh = { "RightUpperLeg", Vector3.new(0, 0, -1.1) },
	LeftKnee = { "LeftLowerLeg", Vector3.new(0, 0.9, -1) }, RightKnee = { "RightLowerLeg", Vector3.new(0, 0.9, -1) },
	LeftAnkle = { "LeftLowerLeg", Vector3.new(0, -0.9, 0) }, RightAnkle = { "RightLowerLeg", Vector3.new(0, -0.9, 0) },
}
local R15_PARTS = { Head = true, UpperTorso = true, LowerTorso = true, LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true, LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
	RightUpperLeg = true, RightLowerLeg = true, RightFoot = true }
local GRIP_LIMBS = { LeftHand = true, RightHand = true, LeftFoot = true, RightFoot = true }

local function decodeGrips(list: any, name: string): { Grip }?
	if list == nil then return nil end
	if type(list) ~= "table" then error("ClipLibrary: throw " .. name .. " grips must be a list") end
	local out: { Grip } = {}
	for i, g in list do
		local where = string.format("ClipLibrary: throw %s grip %d", name, i)
		if type(g) ~= "table" then error(where .. " is not a table") end
		if g.role ~= "Attacker" and g.role ~= "Defender" then error(where .. ": role must be Attacker or Defender") end
		if not GRIP_LIMBS[g.limb] then error(where .. ": limb must be LeftHand/RightHand/LeftFoot/RightFoot") end
		local part, at
		if g.anchor ~= nil then
			local anchor = (ClipLibrary.GRIP_ANCHORS :: any)[g.anchor]
			if not anchor then error(where .. ": unknown anchor " .. tostring(g.anchor)) end
			part, at = anchor[1], anchor[2]
		else
			part, at = g.part, Vector3.zero
		end
		if not R15_PARTS[part] then error(where .. ": unknown R15 part " .. tostring(part)) end
		if type(g.at) == "table" then
			at = Vector3.new(tonumber(g.at[1]) or 0, tonumber(g.at[2]) or 0, tonumber(g.at[3]) or 0)
		end
		if type(g.from) ~= "number" or type(g.to) ~= "number" or g.to < g.from then error(where .. ": needs from <= to (seconds)") end
		table.insert(out, {
			role = g.role, limb = g.limb, part = part, at = at, from = g.from, to = g.to,
			fade = if type(g.fade) == "number" then math.max(g.fade, 0) else 0.06,
			weight = if type(g.weight) == "number" then math.clamp(g.weight, 0, 1) else 1,
		})
	end
	return out
end
ClipLibrary.CHANNELS = 58
ClipLibrary.LIMBS = { "LeftHand", "RightHand", "LeftFoot", "RightFoot" }
ClipLibrary.ROOT_POS = 1
ClipLibrary.ROOT_ROT = 4
ClipLibrary.WAIST = 8
ClipLibrary.NECK = 12
ClipLibrary.LIMB_BASE = { LeftHand = 16, RightHand = 26, LeftFoot = 36, RightFoot = 46 }
ClipLibrary.CONTACT_LEFT = 56
ClipLibrary.CONTACT_RIGHT = 57
ClipLibrary.GROUND = 58

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DIGIT: { [number]: number } = {}
for i = 1, 64 do DIGIT[string.byte(ALPHABET, i)] = i - 1 end
local LEVELS = 4095

-- Quantisation ranges per channel kind (must match tools/mocap/clipio.py).
local function channelRange(c: number): (number, number)
	if c <= 3 then return -2, 2 end
	if c <= 15 then return -1, 1 end
	if c >= 56 then return 0, 1 end
	local k = (c - 16) % 10
	if k < 3 then return -2, 2 end
	return -1, 1
end
ClipLibrary.channelRange = channelRange

local function normFighter(f: any): string
	if type(f) ~= "string" or f == "" or f == "*" or string.lower(f) == "any" then return "*" end
	return string.lower(f)
end

-- Decodes a raw FLClip1 table. Errors on malformed data (clips are generated, never hand-edited).
function ClipLibrary.decode(raw: { [string]: any }, name: string?): Clip
	if type(raw) ~= "table" or raw.format ~= ClipLibrary.FORMAT then error("ClipLibrary: " .. tostring(name) .. " is not an " .. ClipLibrary.FORMAT .. " clip") end
	local frames = raw.frames
	local fps = raw.fps
	local layout = raw.layout
	local data = raw.data
	if type(frames) ~= "number" or frames < 1 or type(fps) ~= "number" or fps <= 0 then error("ClipLibrary: bad header in " .. tostring(name)) end
	if type(layout) ~= "string" or #layout ~= ClipLibrary.CHANNELS or type(data) ~= "string" then error("ClipLibrary: bad layout/data in " .. tostring(name)) end
	local channels = table.create(ClipLibrary.CHANNELS)
	local pos = 1
	for c = 1, ClipLibrary.CHANNELS do
		local lo, hi = channelRange(c)
		local step = (hi - lo) / LEVELS
		if string.byte(layout, c) == 99 then -- "c": constant channel
			local a, b = string.byte(data, pos, pos + 1)
			pos += 2
			channels[c] = lo + (DIGIT[a] * 64 + DIGIT[b]) * step
		else
			local values = table.create(frames)
			for f = 1, frames do
				local a, b = string.byte(data, pos, pos + 1)
				pos += 2
				local da, db = DIGIT[a], DIGIT[b]
				if da == nil or db == nil then error("ClipLibrary: corrupt data in " .. tostring(name) .. " channel " .. c) end
				values[f] = lo + (da * 64 + db) * step
			end
			channels[c] = values
		end
	end
	if pos - 1 ~= #data then error(string.format("ClipLibrary: %s data length %d, expected %d", tostring(name), #data, pos - 1)) end
	local travel = raw.travel
	local duration = if raw.loop then frames / fps else math.max(frames - 1, 1) / fps
	local contact = raw.contact
	if contact == nil and type(raw.contactFrame) == "number" then contact = raw.contactFrame / math.max(frames - 1, 1) end
	return {
		name = raw.name or name or "?",
		fps = fps,
		frames = frames,
		duration = duration,
		loop = raw.loop == true,
		channels = channels,
		contact = contact,
		recover = raw.recover,
		speed = raw.speed or 0,
		travel = if type(travel) == "table" then Vector3.new(travel[1] or 0, travel[2] or 0, travel[3] or 0) else Vector3.zero,
		tags = if type(raw.tags) == "table" then raw.tags else {},
		source = raw.source or "",
		sources = if type(raw.sources) == "table" then raw.sources else {},
		fighter = if raw.fighter ~= nil then normFighter(raw.fighter) else nil,
		move = raw.move,
		stringIndex = raw.stringIndex,
		mirror = raw.mirror == true,
	}
end

-- Index ------------------------------------------------------------------------------------------------------------

type Entry = { raw: { [string]: any }, folder: string, module: ModuleScript }
local entries: { [string]: Entry }? = nil          -- by clip name
local moveIndex: { [string]: { [string]: { [number]: string } } } = {}  -- move key -> fighter -> stringIndex(0 = any) -> name
local throwIndex: { [string]: { [string]: string } } = {}               -- move key -> fighter -> name
local decoded: { [string]: any } = {}
local problems: { string } = {}

local function clipsRoot(): Instance?
	local motion = script.Parent
	return if motion then motion:FindFirstChild("Clips") else nil
end

local function addRaw(raw: any, folder: string, module: ModuleScript, list: { [string]: Entry })
	if type(raw) ~= "table" then table.insert(problems, module:GetFullName() .. ": not a table"); return end
	if raw.format ~= ClipLibrary.FORMAT and raw.format ~= ClipLibrary.THROW_FORMAT then
		-- An array of clips.
		if #raw > 0 then
			for _, item in raw do addRaw(item, folder, module, list) end
		else
			table.insert(problems, module:GetFullName() .. ": unknown clip format " .. tostring(raw.format))
		end
		return
	end
	local name = if type(raw.name) == "string" and raw.name ~= "" then raw.name else module.Name
	if list[name] then table.insert(problems, "duplicate clip name " .. name .. " (" .. module:GetFullName() .. ")") end
	list[name] = { raw = raw, folder = folder, module = module }
	if type(raw.move) == "string" then
		local fighter = normFighter(raw.fighter)
		if raw.format == ClipLibrary.THROW_FORMAT then
			throwIndex[raw.move] = throwIndex[raw.move] or {}
			throwIndex[raw.move][fighter] = name
		else
			moveIndex[raw.move] = moveIndex[raw.move] or {}
			local byFighter = moveIndex[raw.move]
			byFighter[fighter] = byFighter[fighter] or {}
			byFighter[fighter][if type(raw.stringIndex) == "number" then raw.stringIndex else 0] = name
		end
	end
end

-- Builds the index (requires every clip module; decoding stays lazy). Cheap enough to call at load time.
function ClipLibrary.index(): { [string]: Entry }
	local found = entries
	if found then return found end
	local list: { [string]: Entry } = {}
	table.clear(moveIndex)
	table.clear(throwIndex)
	table.clear(problems)
	local root = clipsRoot()
	if root then
		for _, folderName in { "Core", "Moves" } do
			local folder = root:FindFirstChild(folderName)
			if folder then
				for _, d in folder:GetDescendants() do
					if d:IsA("ModuleScript") then
						local ok, raw = pcall(require, d)
						if ok then addRaw(raw, folderName, d, list) else table.insert(problems, d:GetFullName() .. ": " .. tostring(raw)) end
					end
				end
			end
		end
	end
	entries = list
	return list
end

function ClipLibrary.problems(): { string }
	ClipLibrary.index()
	return table.clone(problems)
end

local function decodeRaw(name: string, raw: any): any
	local result: any
	if raw.format == ClipLibrary.THROW_FORMAT then
		if type(raw.attacker) ~= "table" or type(raw.defender) ~= "table" then error("ClipLibrary: throw " .. name .. " needs attacker and defender tracks") end
		result = {
			name = name, fighter = normFighter(raw.fighter), move = raw.move,
			attacker = ClipLibrary.decode(raw.attacker, name .. ".attacker"), defender = ClipLibrary.decode(raw.defender, name .. ".defender"),
			impact = if type(raw.impact) == "number" then raw.impact else 0.6, distance = if type(raw.distance) == "number" then raw.distance else 1.2,
			breakAttacker = if type(raw.breakAttacker) == "table" then ClipLibrary.decode(raw.breakAttacker, name .. ".breakAttacker") else nil,
			breakDefender = if type(raw.breakDefender) == "table" then ClipLibrary.decode(raw.breakDefender, name .. ".breakDefender") else nil,
			grips = decodeGrips(raw.grips, name),
			sources = if type(raw.sources) == "table" then raw.sources else {},
		}
	else
		result = ClipLibrary.decode(raw, name)
	end
	return result
end

local function decodeEntry(name: string): any
	local cached = decoded[name]
	if cached ~= nil then return if cached then cached else nil end
	local entry = ClipLibrary.index()[name]
	if not entry then decoded[name] = false; return nil end
	local ok, result = pcall(decodeRaw, name, entry.raw)
	if not ok then
		-- A malformed shipped clip never breaks the presenter: it is reported (problems(), the clip test fails) and its
		-- move or state falls back to the keyframes.
		decoded[name] = false
		table.insert(problems, tostring(result))
		warn(tostring(result))
		return nil
	end
	decoded[name] = result
	return result
end

-- Returns the decoded clip or nil when no such clip exists.
function ClipLibrary.get(name: string): Clip?
	local clip = decodeEntry(name)
	if clip and clip.attacker then return nil end
	return clip
end

function ClipLibrary.has(name: string): boolean
	return ClipLibrary.get(name) ~= nil
end

-- Style variant lookup: "<base>_<Style>" first, then "<base>".
function ClipLibrary.find(base: string, style: string?): Clip?
	if style then
		local variant = ClipLibrary.get(base .. "_" .. style)
		if variant then return variant end
	end
	return ClipLibrary.get(base)
end

-- Attack clip bound to a roster move. Precedence: this fighter + this string index, this fighter, any fighter + this
-- string index, any fighter. nil = no clip (MotionPlayer falls back to the procedural archetype keyframes).
function ClipLibrary.forMove(characterId: string, moveKey: string, stringIndex: number?): Clip?
	ClipLibrary.index()
	local byFighter = moveIndex[moveKey]
	if not byFighter then return nil end
	local mine, generic = byFighter[string.lower(characterId)], byFighter["*"]
	local s = if type(stringIndex) == "number" then stringIndex else nil
	local name = (mine and ((s and mine[s]) or mine[0])) or (generic and ((s and generic[s]) or generic[0]))
	if not name and mine then for _, n in mine do name = n; break end end
	if not name and generic then for _, n in generic do name = n; break end end
	return if name then ClipLibrary.get(name) else nil
end

-- Two-role throw clip bound to the attacker's roster throw move (fighter-specific beats generic).
function ClipLibrary.forThrow(characterId: string, moveKey: string): ThrowClip?
	ClipLibrary.index()
	local byFighter = throwIndex[moveKey]
	if not byFighter then return nil end
	local name = byFighter[string.lower(characterId)] or byFighter["*"]
	if not name then return nil end
	local clip = decodeEntry(name)
	return if clip and clip.attacker then clip else nil
end

-- Every clip name currently installed (sorted).
function ClipLibrary.list(): { string }
	local names: { string } = {}
	for name in ClipLibrary.index() do table.insert(names, name) end
	table.sort(names)
	return names
end

-- Catalog ids of every source used by the installed clips (sorted, unique): the integrator's credits source.
function ClipLibrary.sourceIds(): { string }
	local seen: { [string]: boolean } = {}
	local ids: { string } = {}
	for _, entry in ClipLibrary.index() do
		local sources = entry.raw.sources
		if type(sources) == "table" then
			for _, id in sources do
				if type(id) == "string" and not seen[id] then seen[id] = true; table.insert(ids, id) end
			end
		end
	end
	table.sort(ids)
	return ids
end

function ClipLibrary.clearCache()
	entries = nil
	table.clear(decoded)
	table.clear(moveIndex)
	table.clear(throwIndex)
end

-- Test hook: registers an in-memory raw clip (FLClip1 or FLThrow1) as if a module returned it (replaces same name).
function ClipLibrary.register(name: string, raw: { [string]: any }): any
	local list = ClipLibrary.index()
	if list[name] then ClipLibrary.unregister(name) end
	local copy = table.clone(raw)
	copy.name = name
	addRaw(copy, "Test", (script :: any), list)
	-- Decode now so a malformed test clip raises here and is never left registered.
	local ok, result = pcall(decodeRaw, name, copy)
	if not ok then
		ClipLibrary.unregister(name)
		error(result, 0)
	end
	decoded[name] = result
	return result
end

function ClipLibrary.unregister(name: string)
	local list = ClipLibrary.index()
	local entry = list[name]
	list[name] = nil
	decoded[name] = nil
	if entry and type(entry.raw.move) == "string" then
		local raw = entry.raw
		local f = normFighter(raw.fighter)
		local isThrow = raw.format == ClipLibrary.THROW_FORMAT
		local slotKey = if type(raw.stringIndex) == "number" then raw.stringIndex else 0
		local byFighter = moveIndex[raw.move]
		if byFighter and byFighter[f] then
			for k, n in byFighter[f] do if n == name then byFighter[f][k] = nil end end
		end
		local throws = throwIndex[raw.move]
		if throws and throws[f] == name then throws[f] = nil end
		-- A clip this one shadowed (same fighter, move and string index) takes its binding back, so a test that
		-- registers over a shipped clip leaves the library as it found it.
		for other, e in list do
			local r = e.raw
			if r.move == raw.move and normFighter(r.fighter) == f and (r.format == ClipLibrary.THROW_FORMAT) == isThrow then
				if isThrow then
					if throws and throws[f] == nil then throws[f] = other end
				elseif byFighter and (if type(r.stringIndex) == "number" then r.stringIndex else 0) == slotKey then
					byFighter[f] = byFighter[f] or {}
					if byFighter[f][slotKey] == nil then byFighter[f][slotKey] = other end
				end
			end
		end
	end
end

return ClipLibrary
