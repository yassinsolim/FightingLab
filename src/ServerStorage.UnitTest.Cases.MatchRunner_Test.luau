--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lab = ReplicatedStorage:WaitForChild("FightingLab")
local MatchRunner = require(Lab:WaitForChild("MatchRunner"))
local Runner = require(game:GetService("ServerStorage").UnitTest.RunUnitTest)

return function(t: Runner.T)
	t.test("commands validate slots and route human inputs", function()
		local folder = Instance.new("Folder")
		local runner = MatchRunner.new({ publishFolder = folder })
		runner:command("SetMode", "Training")
		t.expect.falsy(runner:command("Move", 1, 0, 2))
		t.expect.equal(folder:GetAttribute("LastRejection"), "P2NotHuman")
		runner:setHuman(2, true)
		t.expect.truthy(runner:command("Move", -1, 1, 2))
		t.expect.equal(runner.match.fighters[2].input.moveX, -1)
		t.expect.equal(runner.match.fighters[2].input.moveZ, 1)
		folder:Destroy()
	end)

	t.test("pause blocks gameplay commands but reset still works", function()
		local runner = MatchRunner.new()
		runner:command("SetMode", "Training")
		t.expect.truthy(runner:command("Pause", true))
		t.expect.falsy(runner:command("Move", 1, 0))
		t.expect.truthy(runner:command("Reset"))
		local entry = runner:step()
		t.expect.equal(entry.paused, false)
	end)

	t.test("step returns every-frame entries with p2Human and expanded fighter fields", function()
		local runner = MatchRunner.new()
		runner:command("SetMode", "Training")
		runner:setHuman(2, true)
		t.expect.truthy(runner:command("Attack", "LeadPunch", 101))
		local first = runner:step()
		local second = runner:step()
		t.expect.equal(second.frame, first.frame + 1)
		t.expect.equal(second.p2Human, true)
		local f = second.fighters[1]
		t.expect.truthy(f.velocityY ~= nil)
		t.expect.truthy(f.airFrames ~= nil)
		t.expect.truthy(f.airHits ~= nil)
		t.expect.truthy(f.dashDirection ~= nil)
		t.expect.equal(f.commandId, 101)
		t.expect.truthy(f.moveStartFrame ~= nil)
	end)

	t.test("debug attributes publish mode phase ids score and human state", function()
		local folder = Instance.new("Folder")
		local runner = MatchRunner.new({ publishFolder = folder })
		runner:command("SetMode", "Training")
		runner:setHuman(2, true)
		runner:step()
		t.expect.equal(folder:GetAttribute("Mode"), "Training")
		t.expect.equal(folder:GetAttribute("Phase"), "Fight")
		t.expect.equal(folder:GetAttribute("P1Id"), "Kael")
		t.expect.equal(folder:GetAttribute("P2Id"), "Sierra")
		t.expect.equal(folder:GetAttribute("P2Human"), true)
		t.expect.truthy((folder:GetAttribute("Frame") :: number) >= 1)
		t.expect.truthy(folder:GetAttribute("LearnerHealth") ~= nil)
		t.expect.truthy(folder:GetAttribute("TrainerHealth") ~= nil)
		folder:Destroy()
	end)

	t.test("non-human P2 is CPU-driven during sparring without accepting slot 2 commands", function()
		local runner = MatchRunner.new()
		runner:command("SetMode", "Training")
		runner:command("Spar")
		t.expect.falsy(runner:command("Attack", "LeadPunch", nil, 2))
		for _ = 1, 4 do
			local entry = runner:step()
			t.expect.equal(entry.p2Human, false)
		end
	end)

	t.test("command budgets are per slot so one duel player cannot starve the other", function()
		local Config = require(Lab:WaitForChild("CombatConfig"))
		local runner = MatchRunner.new()
		runner:configure({ mode = "Training", human1 = true, human2 = true })
		for _ = 1, Config.CommandBudget do runner:command("Crouch", false, nil, 1) end
		t.expect.falsy(runner:command("Crouch", false, nil, 1), "slot 1 exhausted")
		t.expect.truthy(runner:command("Crouch", false, nil, 2), "slot 2 unaffected")
	end)

	t.test("configure sets up a duel and restarts a running round for a new opponent", function()
		local Config = require(Lab:WaitForChild("CombatConfig"))
		local runner = MatchRunner.new()
		runner:configure({ mode = "Match", p1Id = "Goran", p2Id = "Nia", stageId = "JungleRuins", difficulty = "Hard", human1 = false, human2 = true })
		t.expect.equal(runner.match.fighters[1].characterId, "Goran")
		t.expect.equal(runner.match.fighters[2].characterId, "Nia")
		t.expect.equal(runner.match.stageId, "JungleRuins")
		t.expect.equal(runner.match.difficulty, "Hard")
		t.expect.equal(runner.human[1], false)
		t.expect.equal(runner.human[2], true)
		t.expect.equal(runner.match.phase, "Ready")
		for _ = 1, Config.ReadyFrames + 2 do runner:step() end
		t.expect.equal(runner.match.phase, "Fight")
		runner:configure({ p2Id = "Kael" })
		t.expect.equal(runner.match.fighters[2].characterId, "Kael")
		t.expect.equal(runner.match.phase, "Ready")
	end)

	t.test("practice dummy cycles Stand Guard Fight and is visible in the entry", function()
		local folder = Instance.new("Folder")
		local runner = MatchRunner.new({ publishFolder = folder })
		runner:command("SetMode", "Training")
		t.expect.equal(runner:step().dummy, "Stand", "training starts with a standing dummy")
		t.expect.truthy(runner:command("Dummy"))
		t.expect.equal(runner:step().dummy, "Guard")
		t.expect.equal(folder:GetAttribute("Dummy"), "Guard")
		t.expect.truthy(runner:command("Dummy"))
		local entry = runner:step()
		t.expect.equal(entry.dummy, "Fight")
		t.expect.equal(entry.sparring, true, "Fight = the CPU spars")
		t.expect.truthy(runner:command("Dummy"))
		t.expect.equal(runner:step().dummy, "Stand", "cycle wraps")
		t.expect.truthy(runner:command("Dummy", "Guard"))
		t.expect.equal(runner:step().dummy, "Guard", "explicit behaviour")
		t.expect.falsy(runner:command("Dummy", "Dance"), "unknown behaviour rejected")
		t.expect.truthy(runner:command("Spar"))
		t.expect.equal(runner:step().dummy, "Fight", "Spar toggles fighting on")
		t.expect.truthy(runner:command("Spar"))
		t.expect.equal(runner:step().dummy, "Guard", "Spar again returns to the resting behaviour")
		t.expect.truthy(runner:command("Reset"))
		t.expect.equal(runner:step().dummy, "Guard", "reset keeps the chosen behaviour")
		runner:command("SetMode", "Match")
		t.expect.falsy(runner:command("Dummy"), "no dummy outside training")
		t.expect.equal(runner:step().dummy, nil)
		folder:Destroy()
	end)

	t.test("guard dummy blocks every height and the standing dummy is hit", function()
		local function outcome(dummy: string, button: string, crouch: boolean): string?
			local runner = MatchRunner.new()
			runner:command("SetMode", "Training")
			runner:command("Dummy", dummy)
			local m = runner.match
			m.fighters[1].pos = Vector3.zero
			m.fighters[2].pos = Vector3.new(3, 0, 0)
			runner:command("Crouch", crouch)
			runner:command("Attack", button, 7)
			for _ = 1, 40 do
				local entry = runner:step()
				for _, e in entry.events do
					if e.attacker == 1 and (e.kind == "Hit" or e.kind == "Block") then return e.kind end
				end
			end
			return nil
		end
		t.expect.equal(outcome("Guard", "LeadPunch", false), "Block", "guard dummy blocks a high")
		t.expect.equal(outcome("Guard", "RearKick", true), "Block", "guard dummy blocks a low")
		t.expect.equal(outcome("Stand", "LeadPunch", false), "Hit", "standing dummy is hit")
	end)

	t.test("1+3 pressed as two Attack commands inside the chord window becomes a throw", function()
		local Config = require(Lab:WaitForChild("CombatConfig"))
		local runner = MatchRunner.new()
		runner:command("SetMode", "Training")
		local m = runner.match
		m.fighters[1].pos = Vector3.zero
		m.fighters[2].pos = Vector3.new(2.8, 0, 0)
		t.expect.truthy(runner:command("Attack", "LeadPunch", 11))
		runner:step()
		t.expect.equal(m.fighters[1].move, "Jab")
		t.expect.truthy(Config.ChordFrames >= 2)
		t.expect.truthy(runner:command("Attack", "LeadKick", 12))
		local entry = runner:step()
		t.expect.equal(m.fighters[1].move, "Throw", "the jab is upgraded into the 1+3 throw")
		t.expect.equal(entry.fighters[1].commandId, 12, "the chord command is the accepted one")
		local started = false
		for _ = 1, 20 do
			for _, e in runner:step().events do if e.kind == "ThrowStart" then started = true end end
		end
		t.expect.truthy(started, "throw connects")
	end)
end
