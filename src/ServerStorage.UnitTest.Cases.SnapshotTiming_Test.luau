--!strict
local Lab = game:GetService("ReplicatedStorage").FightingLab
local Timing = require(Lab.SnapshotTiming)
local Sim = require(Lab.CombatSim)
local Config = require(Lab.CombatConfig)
local Runner = require(game:GetService("ServerStorage").UnitTest.RunUnitTest)
return function(t: Runner.T)
	t.test("publishes accepted startup before the regular cadence", function()
		local m = Sim.newMatch("Training")
		local before = Timing.capture(m, 1)
		Sim.queueAttack(m.fighters[1], "Jab")
		Sim.step(m)
		t.expect.truthy(Timing.shouldPublish(before, Timing.capture(m, 1), 0, 1))
	end)
	t.test("does not publish every active or recovery frame", function()
		local m = Sim.newMatch("Training")
		Sim.queueAttack(m.fighters[1], "Jab")
		Sim.step(m)
		local before = Timing.capture(m, 1)
		Sim.step(m)
		t.expect.falsy(Timing.shouldPublish(before, Timing.capture(m, 1), 0, 2))
		t.expect.truthy(Timing.shouldPublish(before, Timing.capture(m, 1), 0, Config.SnapshotEvery))
	end)
	t.test("publishes events and phase or reset epoch edges immediately", function()
		local m = Sim.newMatch("Training")
		local before = Timing.capture(m, 1)
		t.expect.truthy(Timing.shouldPublish(before, Timing.capture(m, 1), 1, 1))
		t.expect.truthy(Timing.shouldPublish(before, Timing.capture(m, 2), 0, 1))
		m.phase = "RoundOver"
		t.expect.truthy(Timing.shouldPublish(before, Timing.capture(m, 1), 0, 1))
	end)
	t.test("optional attack IDs preserve legacy schema and reject nonfinite or fractional IDs", function()
		t.expect.truthy(Sim.validCommand("Attack", "LeadPunch", nil))
		t.expect.truthy(Sim.validCommand("Attack", "LeadPunch", 1))
		for _, id in { 0, -1, 1.5, math.huge, 0/0 } do t.expect.falsy(Sim.validCommand("Attack", "LeadPunch", id)) end
	end)
end
